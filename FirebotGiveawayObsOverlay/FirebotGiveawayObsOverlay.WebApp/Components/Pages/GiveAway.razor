@using System.Globalization
@using FirebotGiveawayObsOverlay.WebApp.Components.Layout
@using FirebotGiveawayObsOverlay.WebApp.Models
@using FirebotGiveawayObsOverlay.WebApp.Services
@inject GiveawayStateService GiveawayState
@inject ISettingsService SettingsService

@layout NoMenuLayout
@page "/giveaway"
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>Give Away</PageTitle>

@* Zero-size readiness marker (used by e2e tests to know the live connection is up) *@
<span hidden data-overlay-ready="@(RendererInfo.IsInteractive ? "true" : "false")"></span>

@if (snapshot.IsRunning)
{
    <div class="container @(snapshot.HasWinner ? "has-winner" : "")"
         style="@containerStyle"
         data-testid="giveaway-container">
        <div class="prize-section">
            <h1 class="title">
                <span class="primarySpan" style="@gradientTextStyle" data-testid="prize">@snapshot.Prize</span>
            </h1>
        </div>

        <div class="info-section" style="@separatorStyle">
            @if (snapshot.TimerEnabled)
            {
                <h2 class="title-timer @(snapshot.TimerExpired ? "timer-flash" : "")"
                    style="@(snapshot.TimerExpired ? timerExpiredStyle : null)"
                    data-testid="timer">
                    @{ var t = snapshot.Remaining; }
                    @if (t.TotalHours >= 1)
                    {
                        <span class="timer-numbers" style="@timerNumberStyle">@(((int)t.TotalHours).ToString("D2", CultureInfo.InvariantCulture))</span><span class="timer-separator" style="@timerSeparatorStyle">:</span>
                    }
                    @if (t.TotalMinutes >= 1)
                    {
                        <span class="timer-numbers" style="@timerNumberStyle">@t.Minutes.ToString("D2", CultureInfo.InvariantCulture)</span><span class="timer-separator" style="@timerSeparatorStyle">:</span>
                    }
                    <span class="timer-numbers" style="@timerNumberStyle">@t.Seconds.ToString("D2", CultureInfo.InvariantCulture)</span>
                </h2>
            }

            <h2 class="title-entries" style="@textColorStyle">
                @* @key recreates the span when the count changes so the pulse animation replays every time *@
                <span @key="snapshot.EntryCount"
                      class="@(animateEntries ? "entry-count-animate" : "")"
                      style="@gradientTextStyle"
                      data-testid="entry-count">@snapshot.EntryCount</span>
                Entries
            </h2>
        </div>

        @if (snapshot.HasWinner)
        {
            <div class="winner-overlay" data-testid="winner-overlay">
                <h2 class="title-winner">
                    <span class="winner-label" style="@textColorStyle">Winner:</span>
                    <span class="secondarySpan" style="@gradientTextStyle" data-testid="winner">@snapshot.Winner</span>
                </h2>
            </div>
        }
    </div>
}

@code {
    private GiveawaySnapshot snapshot = GiveawaySnapshot.Empty;
    private bool animateEntries;
    private bool disposed;

    // Styles are rebuilt only when settings change, not on every (once-per-second) render.
    private string containerStyle = "";
    private string gradientTextStyle = "";
    private string separatorStyle = "";
    private string textColorStyle = "";
    private string timerNumberStyle = "";
    private string timerSeparatorStyle = "";
    private string timerExpiredStyle = "";

    protected override void OnInitialized()
    {
        BuildStyles(SettingsService.Current);
        snapshot = GiveawayState.Current;

        GiveawayState.SnapshotChanged += HandleSnapshotChanged;
        SettingsService.OnSettingsChanged += HandleSettingsChanged;
    }

    private void HandleSnapshotChanged(GiveawaySnapshot next)
    {
        if (disposed) return;
        _ = InvokeAsync(() =>
        {
            if (disposed) return;
            animateEntries = next.EntryCount != snapshot.EntryCount;
            snapshot = next;
            StateHasChanged();
        }).ContinueWith(static t => _ = t.Exception, TaskContinuationOptions.OnlyOnFaulted);
    }

    private void HandleSettingsChanged()
    {
        if (disposed) return;
        var settings = SettingsService.Current;
        _ = InvokeAsync(() =>
        {
            if (disposed) return;
            BuildStyles(settings);
            StateHasChanged();
        }).ContinueWith(static t => _ = t.Exception, TaskContinuationOptions.OnlyOnFaulted);
    }

    private void BuildStyles(AppSettings settings)
    {
        var theme = settings.Theme;
        var inv = CultureInfo.InvariantCulture;
        int width = settings.PrizeSectionWidthPercent;

        containerStyle = string.Create(inv,
            $"--prize-width: {width}%; --info-width: {100 - width}%; " +
            $"--prize-font-size: {settings.PrizeFontSizeRem:0.0}rem; " +
            $"--timer-font-size: {settings.TimerFontSizeRem:0.0}rem; " +
            $"--entries-font-size: {settings.EntriesFontSizeRem:0.0}rem; " +
            $"background: linear-gradient(135deg, {theme.BackgroundStart} 0%, {theme.BackgroundEnd} 100%); " +
            $"border-color: {theme.BorderGlowColor}; " +
            $"box-shadow: 0 0 20px {theme.PrimaryColor}33, 0 0 40px {theme.SecondaryColor}1A, 0 0 60px {theme.SecondaryColor}1A; " +
            $"--theme-primary: {theme.PrimaryColor}; --theme-secondary: {theme.SecondaryColor};");

        gradientTextStyle =
            $"background: linear-gradient(45deg, {theme.PrimaryColor} 0%, {theme.SecondaryColor} 50%, {theme.PrimaryColor} 100%); " +
            $"-webkit-background-clip: text; background-clip: text; color: transparent; " +
            $"text-shadow: 0 0 10px {theme.PrimaryColor}80, 0 0 20px {theme.PrimaryColor}4D;";

        timerNumberStyle =
            $"background: linear-gradient(45deg, {theme.PrimaryColor} 0%, {theme.SecondaryColor} 50%, {theme.PrimaryColor} 100%); " +
            $"-webkit-background-clip: text; background-clip: text; color: transparent; " +
            $"text-shadow: 0 0 5px {theme.PrimaryColor}66, 0 0 10px {theme.PrimaryColor}33;";

        separatorStyle = $"--separator-color: {theme.SeparatorColor}; --separator-secondary: {theme.SecondaryColor};";
        textColorStyle = $"color: {theme.TextColor};";
        timerSeparatorStyle = textColorStyle;
        timerExpiredStyle = $"color: {theme.TimerExpiredColor};";
    }

    public void Dispose()
    {
        disposed = true;
        GiveawayState.SnapshotChanged -= HandleSnapshotChanged;
        SettingsService.OnSettingsChanged -= HandleSettingsChanged;
    }
}
